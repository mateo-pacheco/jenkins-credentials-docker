pipeline {
  agent any
  parameters {
    credentials credentialType: 'com.cloudbees.plugins.credentials.impl.UsernamePasswordCredentialsImpl', defaultValue: 'Docker', description: 'Credenciales para docker hub', name: 'DOCKER_PARAM', required: true
  }
  environment{
    DOCKER=credentials("${DOCKER_PARAM}")
    //DOCKER  USU:PASS
    //DOCKER_USR   USER
    //DOCKER_PSW    PASSSWORD
  }
  stages {
    stage('Docker Build') {
      steps {
        sh 'docker build -t mateo158/jenkins:${BUILD_NUMBER} .'
      }
    }
    stage('Docker Push') {
      steps {        
          sh "docker login -u ${env.DOCKER_USR} -p ${env.DOCKER_PSW}"
          sh "docker push mateo158/jenkins:${BUILD_NUMBER}"
      }
    }
  }
}
